# Copy to .env.local and fill in. Never commit .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
VITE_ADMIN_PIN=
# International format, digits only, e.g. 2348012345678
VITE_WHATSAPP_NUMBER=
# Paystack needs an email; customers give a phone, so we send <phone>@<domain>.
VITE_PAYSTACK_EMAIL_DOMAIN=inida.ng

# Server-only secrets. Set these as Supabase Edge Function secrets, NOT here:
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_test_... TELEGRAM_BOT_TOKEN=... TELEGRAM_CHAT_ID=...
